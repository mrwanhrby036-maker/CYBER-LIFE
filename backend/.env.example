# الإعداد الحقيقي للإنتاج. انسخ هذا الملف إلى .env واملأ القيم من Firebase Console.
CYBERLIFE_ENV=production
CYBERLIFE_AUTH_MODE=firebase
CYBERLIFE_STORAGE_MODE=firebase
CYBERLIFE_SERVE_FRONTEND=false
CYBERLIFE_LOG_LEVEL=INFO

CYBERLIFE_FIREBASE_PROJECT_ID=hamo-8132e
# عنوان Realtime Database الفعلي من Firebase Console (قد يختلف حسب المنطقة).
CYBERLIFE_FIREBASE_DATABASE_URL=https://hamo-8132e-default-rtdb.europe-west1.firebasedatabase.app
# مسار ملف خدمة Firebase خارج Git. لا تضعه في الواجهة أبداً.
CYBERLIFE_FIREBASE_CREDENTIALS_FILE=
# بديل آمن عبر مدير الأسرار في الاستضافة.
CYBERLIFE_FIREBASE_CREDENTIALS_JSON=
# UID الأدمن الحقيقي من Firebase Authentication.
CYBERLIFE_ADMIN_UIDS=

CYBERLIFE_CORS_ORIGINS=https://your-frontend-domain.vercel.app
CYBERLIFE_CORS_ORIGIN_REGEX=
CYBERLIFE_RATE_LIMIT_PER_MINUTE=180
CYBERLIFE_AUTH_RATE_LIMIT_PER_MINUTE=15
CYBERLIFE_MAX_BODY_BYTES=262144
CYBERLIFE_MAX_REPORT_CHARS=16000

# وضع الاختبار المحلي مخفي ومعطل افتراضياً. لا يستخدم في الإنتاج.
CYBERLIFE_ENABLE_LOCAL_DEV=false
CYBERLIFE_DEV_STUDENT_PASSWORD=
CYBERLIFE_DEV_ADMIN_PASSWORD=
CYBERLIFE_LOCAL_SECRET=
CYBERLIFE_LOCAL_TOKEN_HOURS=8
CYBERLIFE_DATA_DIR=./.data
CYBERLIFE_CONTENT_DIR=../content
CYBERLIFE_FRONTEND_DIR=../frontend
