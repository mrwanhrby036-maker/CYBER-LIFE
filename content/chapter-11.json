  "lessons": [
    {
      "id": "ch11_l01",
      "title": "دورة حياة الاستجابة للحوادث",
      "estimated_minutes": 35,
      "objectives": [
        "شرح مراحل الاستجابة",
        "اختيار إجراء احتواء مناسب",
        "فهم أهمية التصعيد"
      ],
      "introduction": "الاستجابة للحوادث ليست ذعراً ولا حذف ملفات. إنها عملية منظمة: استعداد، اكتشاف وتحليل، احتواء واستئصال وتعافٍ، ثم دروس مستفادة. كل مرحلة لها هدف وأدلة.",
      "sections": [
        {
          "heading": "المراحل",
          "body": "الاستعداد يشمل الخطط والأدوات والتفويض. الاكتشاف والتحليل يحدد ما حدث ونطاقه. الاحتواء يحد الانتشار، والاستئصال يزيل السبب، والتعافي يعيد الخدمة بأمان. الدروس المستفادة تحسن الضوابط. لا تقفز إلى الاستئصال قبل فهم النطاق فقد تفقد أدلة أو تعطل خدمات سليمة."
        },
        {
          "heading": "الاحتواء",
          "body": "الاحتواء قد يكون عزل جهاز، تعطيل حساب، حظر عنوان، أو إيقاف خدمة. لكل إجراء أثر على التوافر والأدلة. اختر أقل إجراء يحد الخطر مع الحفاظ على التحقيق. وثّق من قرر ومتى ولماذا. في التدريب نحاكي هذه القرارات دون لمس أنظمة حقيقية."
        },
        {
          "heading": "التصعيد",
          "body": "ليس كل حادث يحل بنفس المستوى. صعد عندما يتجاوز النطاق صلاحيتك، أو يؤثر على بيانات حساسة، أو يتطلب قراراً قانونياً أو إدارياً. التصعيد المبكر أفضل من إخفاء الحادث. أرفق ملخصاً بالأدلة المؤكدة والفرضيات والإجراءات المتخذة."
        }
      ],
      "terminology": [
        {
          "term": "Incident Response",
          "definition": "عملية منظمة للتعامل مع الحوادث."
        },
        {
          "term": "Containment",
          "definition": "تحديد انتشار الضرر."
        },
        {
          "term": "Eradication",
          "definition": "إزالة سبب الحادث."
        },
        {
          "term": "Recovery",
          "definition": "إعادة الخدمة بأمان."
        },
        {
          "term": "Escalation",
          "definition": "رفع الحادث لمستوى أعلى."
        }
      ],
      "examples": [
        {
          "title": "عزل جهاز",
          "explanation": "جهاز يظهر اتصالاً مشبوهاً؛ عزله شبكياً يحد الانتشار لكنه يقلل التوافر. يوثق القرار ويحفظ الأدلة قبل التغيير الكبير."
        },
        {
          "title": "تعطيل حساب",
          "explanation": "حساب يستخدم من عنوان غير معتاد؛ تعطيله مؤقتاً وإبطال الجلسات قد يكون احتواءً مناسباً مع إبلاغ المستخدم."
        }
      ],
